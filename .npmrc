registry=https://registry.npmmirror.com

# 注意：electron_mirror 和 electron_builder_binaries_mirror 一律不要在这里设置。
#
# 原因：@electron/get 的 mirrorVar() 中，环境变量的优先级高于调用方传入的
# mirrorOptions。而 electron-builder 下载它自己的二进制（dmg-builder 等）时，
# 正是通过 mirrorOptions.mirror 指定 electron-userland 仓库并复用 @electron/get。
# 一旦这里设了 electron_mirror，pnpm 会把它注入为 npm_config_electron_mirror，
# 从而劫持这些下载，去错误的仓库找 dmg-builder@1.2.0 之类的产物并 404，
# 导致 macOS 的 dmg 构建失败（Windows 不走该路径，所以看起来"没问题"）。
#
# 国内需要加速 electron 二进制时，只在安装那一次用临时环境变量，别写进本文件：
#   set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ && pnpm install

# 自动处理依赖相关配置 (pnpm & electron-builder 打包)
shamefully-hoist=true
auto-install-peers=true
strict-peer-dependencies=false
