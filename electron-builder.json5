// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.vela.ide",
  "asar": true,
  "asarUnpack": [
    "node_modules/apache-arrow/**/*",
    "node_modules/better-sqlite3/**/*",
    "node_modules/@lancedb/lancedb-darwin-*/**/*",
    "node_modules/@lancedb/lancedb-linux-*/**/*",
    "node_modules/@lancedb/lancedb-win32-*/**/*"
  ],
  "productName": "Vela",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    "build",
    "public/buyme"
  ],
  "mac": {
    "target": ["dmg"],
    // 必须带 ${arch}：arm64 与 x64 分两个 runner 构建，同名会在 Release 里互相覆盖
    "artifactName": "${productName}-Mac-${version}-${arch}-Installer.${ext}",
    "category": "public.app-category.productivity",
    // 无 Apple Developer 证书，跳过签名（CI 里同时设了 CSC_IDENTITY_AUTO_DISCOVERY=false）
    "identity": null
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-${version}-setup.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "${productName}-${version}-portable.${ext}"
  },
  "linux": {
    "target": ["AppImage"],
    "artifactName": "${productName}-Linux-${version}.${ext}",
    "category": "Office"
  }
}
